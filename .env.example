# Copy to .env (same folder as start.bat) and edit. Every line is optional.

# Where everything is stored: board.sqlite, originals\, previews\, thumbs\, tmp\
# Relative paths are relative to this folder. Example: D:\Board_data
DATA_DIR=.\data

# Port the server listens on
PORT=5180

# Interface to listen on. 127.0.0.1 = this PC only (default). Use 0.0.0.0 on a server / in Docker, and ONLY together with APP_PASSWORD.
#HOST=127.0.0.1

# Set when a reverse proxy or tunnel (cloudflared, Caddy, nginx) is in front, so the server sees real client IPs and https:
# true | number of proxy hops | comma separated proxy IPs/CIDRs. Leave empty when the server is reachable directly.
#TRUST_PROXY=true

# Only needed when ffmpeg / ffprobe are not on PATH
#FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Largest accepted file in GB
MAX_FILE_GB=5

# ComfyUI used by right-click > Open in ComfyUI (never started by the board)
#COMFYUI_URL=http://127.0.0.1:8188

# ---- Online mode (see docs\HOSTING.md) --------------------------------------------------------------
# Login: when set, every page and /api route needs it (except /login and /api/health). Empty = no login (local default).
#APP_PASSWORD=choose-a-long-passphrase

# Storage: local (default, files under DATA_DIR) or s3 (Cloudflare R2: browsers upload/download straight to the bucket)
#STORAGE_DRIVER=s3
#S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#S3_BUCKET=board-media
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto
# Lifetime of the signed media links in seconds (links are cached ~50 min per file so the browser cache works)
#PRESIGN_TTL_S=3600
